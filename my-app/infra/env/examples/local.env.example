COMPOSE_PROJECT_NAME=compliancetool-local
COMPLIANCE_ENV_FILE=../../../.env.docker.local
APP_ENV=local
DEPLOYMENT_TOPOLOGY=private_self_hosted
NODE_ENV=production
APP_PUBLIC_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATED_POSTGRES_PASSWORD__
DATABASE_URL=postgresql://app_runtime:__GENERATED_POSTGRES_PASSWORD__@db:5432/postgres
DRIZZLE_DATABASE_URL=postgresql://postgres:__GENERATED_POSTGRES_PASSWORD__@db:5432/postgres
MIGRATION_DATABASE_NAME=postgres
APP_DATABASE_ROLE=app_runtime
APP_DATABASE_PASSWORD=__GENERATED_POSTGRES_PASSWORD__
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_SECONDS=20

JWT_SECRET=__GENERATED_JWT_SECRET__
ANON_KEY=__GENERATED_ANON_KEY__
SERVICE_ROLE_KEY=__GENERATED_SERVICE_ROLE_KEY__
SUPABASE_PUBLISHABLE_KEY=__GENERATED_SUPABASE_PUBLISHABLE_KEY__
SUPABASE_SECRET_KEY=__GENERATED_SUPABASE_SECRET_KEY__
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=__GENERATED_SUPABASE_PUBLISHABLE_KEY__
SUPABASE_INTERNAL_URL=http://kong:8000
ANON_KEY_ASYMMETRIC=__GENERATED_ANON_KEY_ASYMMETRIC__
SERVICE_ROLE_KEY_ASYMMETRIC=__GENERATED_SERVICE_ROLE_KEY_ASYMMETRIC__
JWT_KEYS=__GENERATED_JWT_KEYS__
JWT_JWKS=__GENERATED_JWT_JWKS__
JWT_EXPIRY=3600

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SMTP_ADMIN_EMAIL=admin@example.invalid
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASS=local
SMTP_SENDER_NAME=Compliance Tool

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

RUSTFS_ACCESS_KEY=__GENERATED_RUSTFS_ACCESS_KEY__
RUSTFS_SECRET_KEY=__GENERATED_RUSTFS_SECRET_KEY__
GLOBAL_S3_BUCKET=supabase-storage
GLOBAL_S3_ENDPOINT=http://rustfs:9000
GLOBAL_S3_PROTOCOL=http
GLOBAL_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=__GENERATED_RUSTFS_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__GENERATED_RUSTFS_SECRET_KEY__
REGION=eu-central-1
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=__GENERATED_S3_PROTOCOL_ACCESS_KEY_ID__
S3_PROTOCOL_ACCESS_KEY_SECRET=__GENERATED_S3_PROTOCOL_ACCESS_KEY_SECRET__

AI_DEFAULT_PROVIDER=self_hosted
SELF_HOSTED_AI_BASE_URL=http://litellm:4000/v1
SELF_HOSTED_AI_API_KEY=__GENERATED_LITELLM_MASTER_KEY__
SELF_HOSTED_AI_MODEL=compliance-chat
SELF_HOSTED_AI_SMALL_MODEL=compliance-chat
SELF_HOSTED_AI_EMBEDDING_MODEL=compliance-embedding
SELF_HOSTED_AI_EMBEDDING_REVISION=qwen3-embedding-4b-q4_K_M
SELF_HOSTED_AI_MAX_CONTEXT_TOKENS=32768
SELF_HOSTED_AI_SUPPORTS_STRUCTURED_OUTPUTS=true
SELF_HOSTED_AI_SUPPORTS_TOOL_CALLS=false
SELF_HOSTED_AI_SUPPORTS_STREAMING=true
SELF_HOSTED_AI_CITATION_RELIABILITY=medium
SELF_HOSTED_AI_RECOMMENDED_TEMPERATURE=0.1
AI_EMBEDDING_DIM=1536
AI_GROUNDED_MAX_OUTPUT_TOKENS=9000
AI_PROVIDER_TIMEOUT_MS=120000
LITELLM_MASTER_KEY=__GENERATED_LITELLM_MASTER_KEY__
OLLAMA_CHAT_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b-q4_K_M

API_CURSOR_SECRET=__GENERATED_API_CURSOR_SECRET__
WORKER_ID=local-full-1
WORKER_DEBUG_ERRORS=0
DOCLING_SERVICE_URL=http://docling:5001

COMPLIANCETOOL_WEB_IMAGE=compliancetool/web:local
COMPLIANCETOOL_WORKER_IMAGE=compliancetool/worker:local
COMPLIANCETOOL_REVISION=local
COMPLIANCETOOL_SOURCE=https://github.com/nxkolas/compliance

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=__GENERATED_DASHBOARD_PASSWORD__
PG_META_CRYPTO_KEY=__GENERATED_PG_META_CRYPTO_KEY__
STUDIO_DEFAULT_ORGANIZATION=Compliance Tool
STUDIO_DEFAULT_PROJECT=Local
