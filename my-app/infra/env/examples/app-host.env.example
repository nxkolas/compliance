APP_ENV=production
DEPLOYMENT_TOPOLOGY=private_self_hosted
NODE_ENV=production
PLATFORM_PROJECT_NAME=compliancetool-production-platform
RELEASE_PROJECT_NAME=compliancetool-production-release
APP_DATA_ROOT=/srv/compliancetool/production
APP_ENV_FILE=/etc/compliancetool/production/application.env
APP_DOMAIN=app.example.com
SUPABASE_DOMAIN=supabase.example.com
APP_PUBLIC_URL=https://app.example.com
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com
SITE_URL=https://app.example.com
ADDITIONAL_REDIRECT_URLS=https://app.example.com/**
CADDY_ACME_EMAIL=operations@example.com
CADDY_ACTIVE_UPSTREAM_FILE=/srv/compliancetool/production/releases/active-upstream.caddy

EDGE_NETWORK_NAME=compliancetool-production-edge
APP_NETWORK_NAME=compliancetool-production-app
DATA_NETWORK_NAME=compliancetool-production-data
EGRESS_NETWORK_NAME=compliancetool-production-egress
OBSERVABILITY_NETWORK_NAME=compliancetool-production-observability
ENABLE_OBSERVABILITY=true
ENABLE_STUDIO=false
STUDIO_PORT=54323
PG_META_CRYPTO_KEY=replace-with-32-byte-random-secret
STUDIO_DEFAULT_ORGANIZATION=Compliance Tool
STUDIO_DEFAULT_PROJECT=Production
DASHBOARD_USERNAME=operations
DASHBOARD_PASSWORD=replace-with-random-dashboard-password
PROMETHEUS_RETENTION=30d
ALERTMANAGER_WEBHOOK_FILE=/etc/compliancetool/production/alertmanager-webhook-url

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-in-secret-file
DATABASE_URL=postgresql://app_runtime:replace-in-secret-file@db:5432/postgres
DRIZZLE_DATABASE_URL=postgresql://postgres:replace-in-secret-file@db:5432/postgres
DISPOSABLE_SCHEMA_TARGET=db:5432/postgres
MIGRATION_DATABASE_NAME=postgres
APP_DATABASE_ROLE=app_runtime
APP_DATABASE_PASSWORD=replace-in-secret-file
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_SECONDS=20

JWT_SECRET=replace-with-32-byte-minimum-secret
ANON_KEY=replace-with-legacy-anon-jwt
SERVICE_ROLE_KEY=replace-with-legacy-service-jwt
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_SECRET_KEY=sb_secret_replace
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_INTERNAL_URL=http://kong:8000
ANON_KEY_ASYMMETRIC=replace-with-es256-anon-jwt
SERVICE_ROLE_KEY_ASYMMETRIC=replace-with-es256-service-jwt
JWT_KEYS=[]
JWT_JWKS={"keys":[]}
JWT_EXPIRY=3600

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SMTP_ADMIN_EMAIL=operations@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace
SMTP_PASS=replace
SMTP_SENDER_NAME=Compliance Tool

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000
GLOBAL_S3_BUCKET=compliancetool-production-storage
GLOBAL_S3_ENDPOINT=https://s3.eu.example.com
GLOBAL_S3_PROTOCOL=https
GLOBAL_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace
REGION=eu-central-1
STORAGE_TENANT_ID=production
S3_PROTOCOL_ACCESS_KEY_ID=replace
S3_PROTOCOL_ACCESS_KEY_SECRET=replace

# Backup-only credentials must not be the Storage service credentials.
WALG_S3_PREFIX=s3://compliancetool-production-backups/postgresql
BACKUP_S3_ENDPOINT=https://backup-s3.eu.example.com
BACKUP_REGION=eu-central-1
BACKUP_AWS_ACCESS_KEY_ID=replace-with-backup-only-key
BACKUP_AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_MAX_AGE_HOURS=24
STORAGE_INVENTORY_ACCESS_KEY_ID=replace-with-read-only-inventory-key
STORAGE_INVENTORY_SECRET_ACCESS_KEY=replace-with-read-only-inventory-secret
STORAGE_RESTORE_CANARY_OBJECT=replace-with-versioned-canary-object-key
STORAGE_RESTORE_CANARY_VERSION_ID=replace-with-exact-version-id
STORAGE_RESTORE_CANARY_SHA256=replace-with-canary-sha256

# The application reaches an OpenAI-compatible endpoint over the egress
# network. Point SELF_HOSTED_AI_BASE_URL at a private inference endpoint if one
# exists, or select the openai provider and supply OPENAI_* instead.
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=replace-with-chat-model
OPENAI_SMALL_MODEL=replace-with-small-chat-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_GROUNDED_MAX_OUTPUT_TOKENS=9000
AI_PROVIDER_TIMEOUT_MS=120000
API_CURSOR_SECRET=replace-with-32-byte-secret
WORKER_DEBUG_ERRORS=0
DOCLING_SERVICE_URL=http://docling:5001

WEB_IMAGE=ghcr.io/example/compliancetool-web@sha256:replace
WORKER_IMAGE=ghcr.io/example/compliancetool-worker@sha256:replace
COMPLIANCETOOL_DB_IMAGE=ghcr.io/example/compliancetool-database@sha256:replace
COMPLIANCETOOL_STORAGE_IMAGE=ghcr.io/example/compliancetool-storage@sha256:replace
COMPLIANCETOOL_STUDIO_IMAGE=ghcr.io/example/compliancetool-studio@sha256:replace
COMPLIANCETOOL_META_IMAGE=ghcr.io/example/compliancetool-postgres-meta@sha256:replace
RELEASE_REVISION=replace-with-git-sha
