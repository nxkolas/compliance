AI_PROJECT_NAME=compliancetool-ai-production
AI_DATA_ROOT=/srv/compliancetool/ai
WIREGUARD_BIND_ADDRESS=10.60.0.2
WIREGUARD_APP_PEER_ADDRESS=10.60.0.1
LITELLM_MASTER_KEY=replace-with-ai-admin-only-key
LITELLM_APPLICATION_KEY=replace-with-app-only-key

CHAT_MODEL_REPOSITORY=Qwen/Qwen3.5-27B-FP8
CHAT_MODEL_REVISION=97f5941bf617e31c5e237364a8602ce3f03a551a
CHAT_MODEL_PATH=/srv/compliancetool/ai/models/chat
CHAT_MODEL_ALIAS=compliance-chat
CHAT_MAX_MODEL_LEN=131072
CHAT_MAX_NUM_SEQS=2
CHAT_GPU_MEMORY_UTILIZATION=0.72

EMBEDDING_MODEL_REPOSITORY=Qwen/Qwen3-Embedding-4B
EMBEDDING_MODEL_REVISION=5cf2132abc99cad020ac570b19d031efec650f2b
EMBEDDING_MODEL_PATH=/srv/compliancetool/ai/models/embedding
EMBEDDING_MODEL_ALIAS=compliance-embedding
EMBEDDING_MAX_MODEL_LEN=8192
EMBEDDING_GPU_MEMORY_UTILIZATION=0.18

NVIDIA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ENABLE_OBSERVABILITY=true
DASHBOARD_USERNAME=operations
DASHBOARD_PASSWORD=replace-with-random-dashboard-password
PROMETHEUS_RETENTION=30d
ALERTMANAGER_WEBHOOK_FILE=/etc/compliancetool/ai/alertmanager-webhook-url

WIREGUARD_INTERFACE_ADDRESS=10.60.0.2/32
WIREGUARD_LISTEN_PORT=51820
WIREGUARD_PRIVATE_KEY_FILE=/etc/wireguard/compliancetool-ai.key
WIREGUARD_PEER_PUBLIC_KEY=replace-with-app-host-public-key
WIREGUARD_PEER_ALLOWED_IP=10.60.0.1/32
WIREGUARD_PEER_ENDPOINT=app-host-public-ip:51820
